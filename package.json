{
  "name": "assistant-listing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gig listing page with an embedded conversational assistant.",
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "uv run --directory backend python -m app",
    "dev:client": "npm --prefix client run dev",
    "setup": "uv sync --directory backend && npm --prefix client install",
    "test": "uv run --directory backend pytest",
    "typecheck": "npm --prefix client run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
